# ----- SamDesk environment variables -----
# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values to git.

# Postgres connection string from Neon (use the POOLED connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# A long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The full public URL of your deployed app (no trailing slash).
NEXTAUTH_URL="https://your-app.vercel.app"

# Secret required to call /api/seed (creates the team accounts). Pick any random string.
SEED_SECRET="replace-with-a-random-seed-secret"

# OPTIONAL — set strong initial passwords for each role (recommended).
# If omitted, weak defaults are used and you must change them after first login.
# DIRECTOR_PASSWORD=""
# VP_PASSWORD=""
# ACCOUNTS_PASSWORD=""
# MFG_PASSWORD=""
# DESIGN_PASSWORD=""
# SALES_PASSWORD=""

# OPTIONAL — enables the AI-written intro emails (otherwise a template is used).
# ANTHROPIC_API_KEY=""
