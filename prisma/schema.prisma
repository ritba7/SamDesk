generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    // director, vp, accounts, manufacturing, design
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedDeals Deal[]    @relation("AssignedTo")
  createdDeals  Deal[]    @relation("CreatedBy")
  activities    Activity[]
  tasks         Task[]    @relation("AssignedTasks")
  createdTasks  Task[]    @relation("CreatedTasks")

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id              String   @id @default(cuid())
  dealNumber      String   @unique

  // Customer info
  customerName    String
  customerCompany String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerState   String?

  // Product specs
  material        String?  // ms, ss304, ss202, ms+ss202, ms+ss304
  motorType       String?  // ie2, ie3
  motorBrand      String?  // siemens, bharatbijli, other
  motorBrandOther String?
  outerDepth      Float?
  outerHeight     Float?
  outerWidth      Float?
  innerDepth      Float?
  innerHeight     Float?
  innerWidth      Float?
  specNotes       String?

  // Air shower model selection (from brochure)
  modelNumber     String?  // e.g. S3138, SS110RE
  airShowerConfig String?  // straight, RE, LE, SR, SL, RL
  application     String?  // pharma, automobile, electronics, food, etc.
  numberOfUsers   Int?     // users per cycle
  entryType       String?  // human, human_trolley, material
  airFlowTime     String?  // seconds: 10/15/20/30/40/60
  doorType        String?  // hinged, sliding, rollup, shutter, pvc, air_curtain
  flooringRequired Boolean @default(false)
  inputPower      String?  @default("440V / 50Hz")

  // Logistics
  freightPaidBy   String?  // customer, company
  installationType String? // none, online, onsite

  // Stage tracking
  stage           String   @default("inquiry")

  heatScore       String   @default("warm") // hot, warm, cold
  lostReason      String?
  lostNotes       String?

  // Dates
  inquiryDate     DateTime @default(now())
  expectedDispatch DateTime?
  actualDispatch  DateTime?

  // Financial
  quotedAmount    Float?
  advanceAmount   Float?
  advanceReceived Boolean  @default(false)
  advanceDate     DateTime?
  balanceAmount   Float?
  balancePaid     Boolean  @default(false)
  balanceDate     DateTime?
  balanceDeadline DateTime? // deadline to receive balance payment
  gstRate         Float?   @default(18)

  // Inquiry & verification
  gstNumber         String?
  verificationScore Int?    @default(0)
  verificationData  String? // JSON
  productInterest   String?
  querySummary      String?
  estimatedQty      Int?
  timeline          String?
  budgetIndication  Float?
  priority          String? @default("medium")
  source            String?
  customerWebsite   String?
  specialRequirements String?
  roughWidth        Float?
  roughHeight       Float?
  roughDepth        Float?
  motorPreference   String?
  internalNotes     String?
  expectedCloseDate DateTime?

  // Terms
  paymentTerms     String?   // e.g. "50% advance, 50% before dispatch"
  freightTerms     String?   // detailed freight terms
  inspectionTerms  String?   // "waiver" or custom terms
  introEmail       String?   // stored auto-generated intro email
  tdsDeadline      DateTime? // deadline for sending TDS
  advanceDeadline  DateTime? // deadline to receive advance payment
  advanceNote      String?   // note about advance terms

  // Flags
  inspectionType  String?  // physical, waiver
  installationDone Boolean @default(false)

  // Phase 1+2 additions
  serialNumber   String?  // e.g. AS-ABCP-SE1_050726_02
  dealFinalized  Boolean  @default(false)  // specs+commercials frozen
  poSnapshot     String?  // JSON snapshot of the pre-PO (lead) data, kept for audit
  finalDataEntered Boolean @default(false) // salesman has re-entered final PO data
  productOther   String?  // manual product name when productInterest = 'other'
  flooringType   String?  // ss_sheet, ms_pvc, grated, shoe_sole_cleaner, without, antistatic
  doorLeaf       String?  // single, double, without
  nextFollowUpAt DateTime?
  nextFollowUpMode String? // call, mail

  // Commercials (filled by sales)
  basicPrice        Float?
  discountType      String?   // percent, amount
  discountValue     Float?
  finalPrice        Float?
  freightBearer     String?   // customer_pays, we_bear, we_ask_extra
  freightAmount     Float?
  assemblyAtSite    String?   // not_required, chargeable, included, visit_after_supply
  assemblyCharge    Float?
  warrantyTerms     String?   @default("365 days from date of supply (dispatch) or 419 days from date of intimation of inspection")
  insuranceNote     String?   @default("Insurance to freight bearer's scope")
  paymentSchedule   String?   // JSON array of payment milestones [{label,type,value,trigger,days,note}]
  commercialsDone   Boolean   @default(false)

  // Vetting flow
  vettingStatus     String    @default("not_submitted") // not_submitted, pending, approved, rejected
  vettingNote       String?
  vettedById        String?
  vettedAt          DateTime?
  workCode          String?   @unique  // unique code assigned by accounts on approval
  quoteVetStatus    String    @default("none") // none, requested, vetted

  // Dispatch chain (Phase 4)
  dispatchStatus  String?  // payment_pending, payment_received, truck_arranged, forklift_called, loaded, tarp_verified, dispatched, unloaded, assembly_planned, closed
  dispatchDate    DateTime?
  packingListNote String?

  assignedToId    String?
  createdById     String

  assignedTo      User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])

  activities      Activity[]
  tasks           Task[]
  contacts        ContactPerson[]
  documents       Document[]
  productionStages ProductionStage[]
  quotes          Quote[]
  payments        Payment[]
  proformaInvoices ProformaInvoice[]
  workOrders      WorkOrder[]
  materialRequests MaterialRequest[]
  inspection      InspectionChecklist?
  changeLogs      ChangeLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProformaInvoice {
  id          String   @id @default(cuid())
  dealId      String
  piNumber    String   @unique   // SPPI/MMYY/serial
  poReference String?  // customer PO number this PI is against
  amount      Float
  notes       String?
  createdById String?
  released    Boolean  @default(true)
  deal        Deal     @relation(fields: [dealId], references: [id])
  workOrder   WorkOrder?
  createdAt   DateTime @default(now())
}

model WorkOrder {
  id            String   @id @default(cuid())
  dealId        String
  piId          String?  @unique
  woNumber      String   @unique  // SPWO/{model}/{MMYY}/{serial}
  specSnapshot  String?  // JSON snapshot of specs at generation time
  filledData    String?  // JSON of the detailed WO tickbox form (production + accounts)
  status        String   @default("pending_approval") // pending_approval, approved, in_production, completed
  approvedByAccounts Boolean @default(false)
  approvedByAccountsAt DateTime?
  vettedByDirector   Boolean @default(false)
  vettedByDirectorAt DateTime?
  deadline      DateTime?
  deal          Deal     @relation(fields: [dealId], references: [id])
  pi            ProformaInvoice? @relation(fields: [piId], references: [id])
  createdAt     DateTime @default(now())
}

model MaterialRequest {
  id        String   @id @default(cuid())
  dealId    String
  woNumber  String?
  items     String   // JSON array [{item, spec, qty}]
  status    String   @default("pending") // pending, ordered, received
  notes     String?
  createdById String?
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspectionChecklist {
  id        String   @id @default(cuid())
  dealId    String   @unique
  data      String   // JSON of all checklist fields
  mfgApproved  Boolean @default(false)
  mfgApprovedAt DateTime?
  vpApproved   Boolean @default(false)
  vpApprovedAt DateTime?
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id          String   @id @default(cuid())
  dealId      String
  version     Int      @default(1)
  amount      Float
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  deal        Deal     @relation(fields: [dealId], references: [id])
}

model ProductionStage {
  id          String   @id @default(cuid())
  dealId      String
  stageName   String
  order       Int
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  status      String   @default("pending") // pending, in_progress, completed, delayed
  notes       String?
  deal        Deal     @relation(fields: [dealId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  dealId    String?
  userId    String
  type      String   // stage_change, note, call, document, payment, task
  content   String
  metadata  String?  // JSON string
  highlighted Boolean @default(false)
  deal      Deal?    @relation(fields: [dealId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ContactPerson {
  id        String  @id @default(cuid())
  dealId    String
  name      String
  phone     String?
  email     String?
  designation String?
  isPrimary Boolean @default(false)
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  dealId      String?
  title       String
  description String?
  assignedToId String
  createdById String
  dueDate     DateTime?
  status      String   @default("pending") // pending, done
  type        String   @default("follow_up") // follow_up, document, call, other
  advancesToStage String? // when this task is completed, move the deal to this stage
  deal        Deal?    @relation(fields: [dealId], references: [id])
  assignedTo  User     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy   User     @relation("CreatedTasks", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChangeLog {
  id        String   @id @default(cuid())
  dealId    String
  userId    String?
  userName  String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(cuid())
  dealId    String
  type      String   // tds, quote, pi, po, dispatch_clearance, test_cert, manual
  version   Int      @default(1)
  filename  String
  content   String?  // JSON data used to generate
  createdById String?
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id           String    @id @default(cuid())
  dealId       String
  type         String    // advance, balance, milestone, other
  amount       Float
  date         DateTime
  scheduledDate DateTime? // when payment is expected (for reminders)
  notes        String?
  paymentMode  String?   // NEFT, RTGS, cheque, cash, UPI, other
  utrNumber    String?   // UTR / reference number
  bankAccount  String?   // which bank account received
  received     Boolean   @default(true) // false = scheduled/expected
  deal         Deal      @relation(fields: [dealId], references: [id])
  createdAt    DateTime  @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  dealId      String?
  category    String   // freight, installation, raw_material, vendor, salary, other
  amount      Float
  date        DateTime
  dueDate     DateTime? // when payment is scheduled to go out
  paid        Boolean  @default(true) // false = scheduled/upcoming payable
  vendorName  String?
  utrNumber   String?
  paymentMode String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Inventory {
  id          String   @id @default(cuid())
  itemName    String
  category    String   // raw_material, hardware, electrical, other
  quantity    Float
  unit        String
  threshold   Float    @default(0)
  unitCost    Float?
  supplier    String?
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

