generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    // director, vp, accounts, manufacturing, design
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedDeals Deal[]    @relation("AssignedTo")
  createdDeals  Deal[]    @relation("CreatedBy")
  activities    Activity[]
  tasks         Task[]    @relation("AssignedTasks")
  createdTasks  Task[]    @relation("CreatedTasks")

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id              String   @id @default(cuid())
  dealNumber      String   @unique

  // Customer info
  customerName    String
  customerCompany String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  customerState   String?

  // Product specs
  material        String?  // ms, ss304, ss202, ms+ss202, ms+ss304
  motorType       String?  // ie2, ie3
  motorBrand      String?  // siemens, bharatbijli, other
  motorBrandOther String?
  outerDepth      Float?
  outerHeight     Float?
  outerWidth      Float?
  innerDepth      Float?
  innerHeight     Float?
  innerWidth      Float?
  specNotes       String?

  // Logistics
  freightPaidBy   String?  // customer, company
  installationType String? // none, online, onsite

  // Stage tracking
  stage           String   @default("inquiry")

  heatScore       String   @default("warm") // hot, warm, cold
  lostReason      String?
  lostNotes       String?

  // Dates
  inquiryDate     DateTime @default(now())
  expectedDispatch DateTime?
  actualDispatch  DateTime?

  // Financial
  quotedAmount    Float?
  advanceAmount   Float?
  advanceReceived Boolean  @default(false)
  advanceDate     DateTime?
  balanceAmount   Float?
  balancePaid     Boolean  @default(false)
  balanceDate     DateTime?
  gstRate         Float?   @default(18)

  // Inquiry & verification
  gstNumber         String?
  verificationScore Int?    @default(0)
  verificationData  String? // JSON
  productInterest   String?
  querySummary      String?
  estimatedQty      Int?
  timeline          String?
  budgetIndication  Float?
  priority          String? @default("medium")
  source            String?
  customerWebsite   String?
  specialRequirements String?
  roughWidth        Float?
  roughHeight       Float?
  roughDepth        Float?
  motorPreference   String?
  internalNotes     String?
  expectedCloseDate DateTime?

  // Terms
  paymentTerms     String?   // e.g. "50% advance, 50% before dispatch"
  freightTerms     String?   // detailed freight terms
  inspectionTerms  String?   // "waiver" or custom terms
  introEmail       String?   // stored auto-generated intro email
  tdsDeadline      DateTime? // deadline for sending TDS
  advanceDeadline  DateTime? // deadline to receive advance payment
  advanceNote      String?   // note about advance terms

  // Flags
  inspectionType  String?  // physical, waiver
  installationDone Boolean @default(false)

  assignedToId    String?
  createdById     String

  assignedTo      User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])

  activities      Activity[]
  tasks           Task[]
  documents       Document[]
  productionStages ProductionStage[]
  quotes          Quote[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Quote {
  id          String   @id @default(cuid())
  dealId      String
  version     Int      @default(1)
  amount      Float
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  deal        Deal     @relation(fields: [dealId], references: [id])
}

model ProductionStage {
  id          String   @id @default(cuid())
  dealId      String
  stageName   String
  order       Int
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  status      String   @default("pending") // pending, in_progress, completed, delayed
  notes       String?
  deal        Deal     @relation(fields: [dealId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  dealId    String?
  userId    String
  type      String   // stage_change, note, call, document, payment, task
  content   String
  metadata  String?  // JSON string
  deal      Deal?    @relation(fields: [dealId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  dealId      String?
  title       String
  description String?
  assignedToId String
  createdById String
  dueDate     DateTime?
  status      String   @default("pending") // pending, done
  type        String   @default("follow_up") // follow_up, document, call, other
  deal        Deal?    @relation(fields: [dealId], references: [id])
  assignedTo  User     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy   User     @relation("CreatedTasks", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  dealId    String
  type      String   // tds, quote, pi, po, dispatch_clearance, test_cert, manual
  version   Int      @default(1)
  filename  String
  content   String?  // JSON data used to generate
  createdById String?
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  dealId    String
  type      String   // advance, balance, other
  amount    Float
  date      DateTime
  notes     String?
  paymentMode  String?  // NEFT, RTGS, cheque, cash, UPI, other
  utrNumber    String?  // UTR / reference number
  bankAccount  String?  // which bank account received
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())
}

model Inventory {
  id          String   @id @default(cuid())
  itemName    String
  category    String   // raw_material, hardware, electrical, other
  quantity    Float
  unit        String
  threshold   Float    @default(0)
  unitCost    Float?
  supplier    String?
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  dealId    String?
  category  String   // freight, installation, raw_material, other
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
}
